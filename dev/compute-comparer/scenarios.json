{
  "_comment": [
    "Settings matrix for the app-vs-script pgx parity harness.",
    "JSON rather than YAML so node reads it with zero dependencies (R has jsonlite).",
    "Each scenario = defaults deep-merged with its own keys.",
    "'qc' maps 1:1 onto the upload-checkqc-* inputs; run_script.R translates it",
    "into the playbase::pgx.preprocess options list (see docs/script-pipeline.md).",
    "NOTE: neither fixture contains NAs, so filtermissing/impute are no-ops unless",
    "zero_as_na is also true -- both implementations guard on sum(is.na(X)) > 0."
  ],
  "fixtures": {
    "human-symbol": {
      "dir": "/home/massagno/bigomics/GitHub/opg-exampledata/human-symbol",
      "datatype": "RNA-seq",
      "organism": "Human",
      "batch_param": "cluster"
    },
    "mini-example": {
      "dir": "/home/massagno/bigomics/GitHub/opg-exampledata/mini-example",
      "datatype": "proteomics",
      "organism": "Human",
      "batch_param": "cluster"
    },
    "salmon-dups": {
      "dir": "/home/massagno/bigomics/GitHub/opg-exampledata/salmon-ENSOKI",
      "datatype": "RNA-seq",
      "organism": "Oncorhynchus kisutch",
      "batch_param": null,
      "_note": "999 features, 30 DUPLICATED feature names - exercises the cleanX intersect() collapse"
    },
    "metabolomics-dups": {
      "dir": "/home/massagno/bigomics/GitHub/opg-exampledata/lipidomics_underscore",
      "datatype": "metabolomics",
      "organism": "Human",
      "batch_param": null,
      "_note": "180 features, 22 duplicated names, metabolomics norm branch"
    },
    "human-dups": {
      "dir": "/home/massagno/bigomics/GitHub/omicsplayground-compute-comparer/dev/compute-comparer/fixtures/human-dups",
      "datatype": "RNA-seq",
      "organism": "Human",
      "batch_param": "cluster",
      "_note": "human-symbol + 40 duplicated gene symbols (7479 rows). Built by fixtures/make_human_dups.R"
    }
  },
  "defaults": {
    "fixture": "human-symbol",
    "description": "compute-comparer parity fixture",
    "qc": {
      "zero_as_na": false,
      "filtermissing": false,
      "filterthreshold": "0.2",
      "impute": true,
      "impute_method": "SVD2",
      "normalize": true,
      "normalization_method": "CPM",
      "ref_gene": null,
      "remove_outliers": false,
      "outlier_threshold": 6,
      "batchcorrect": false,
      "bec_method": "SVA",
      "bec_param": null
    },
    "compute": {
      "gene_methods": [
        "ttest",
        "trend.limma"
      ],
      "gset_methods": [
        "fisher",
        "fgsea"
      ],
      "do_extra": false,
      "extra_methods": [],
      "filter_methods": [
        "append.symbol",
        "remove.notexpressed",
        "remove.unknown",
        "only.proteincoding"
      ],
      "dotimeseries": false,
      "exclude_void": false
    }
  },
  "scenarios": [
    {
      "id": "baseline",
      "note": "app defaults, nothing touched. The control -- must pass."
    },
    {
      "id": "norm-cpm-quantile",
      "qc": {
        "normalization_method": "CPM+quantile"
      }
    },
    {
      "id": "norm-tmm",
      "qc": {
        "normalization_method": "TMM"
      }
    },
    {
      "id": "norm-quantile",
      "qc": {
        "normalization_method": "quantile"
      }
    },
    {
      "id": "norm-maxmedian",
      "qc": {
        "normalization_method": "maxMedian"
      }
    },
    {
      "id": "norm-maxsum",
      "qc": {
        "normalization_method": "maxSum"
      }
    },
    {
      "id": "norm-off",
      "qc": {
        "normalize": false
      },
      "note": "exercises the grepl('CPM|TMM') prior switch with normalization skipped"
    },
    {
      "id": "outlier-t3",
      "qc": {
        "remove_outliers": true,
        "outlier_threshold": 3
      },
