    {
      "id": "outlier-t6",
      "qc": {
        "remove_outliers": true,
        "outlier_threshold": 6
      }
    },
    {
      "id": "na-zero",
      "qc": {
        "zero_as_na": true,
        "impute": false
      },
      "note": "19280 zeros -> NA; the gateway scenario for every NA path below"
    },
    {
      "id": "na-filter-ratio",
      "qc": {
        "zero_as_na": true,
        "impute": false,
        "filtermissing": true,
        "filterthreshold": "0.2"
      }
    },
    {
      "id": "na-filter-group",
      "qc": {
        "zero_as_na": true,
        "impute": false,
        "filtermissing": true,
        "filterthreshold": "3"
      },
      "note": "the f >= 1 branch (string comparison -- pass the string, not 3)"
    },
    {
      "id": "na-filter-groupratio",
      "qc": {
        "zero_as_na": true,
        "impute": false,
        "filtermissing": true,
        "filterthreshold": "-0.5"
      },
      "note": "the f < 0 branch"
    },
    {
      "id": "na-impute-svd2",
      "qc": {
        "zero_as_na": true,
        "impute": true,
        "impute_method": "SVD2"
      }
    },
    {
      "id": "na-impute-qrilc",
      "qc": {
        "zero_as_na": true,
        "impute": true,
        "impute_method": "QRILC"
      }
    },
    {
      "id": "na-outlier",
      "qc": {
        "zero_as_na": true,
        "impute": false,
        "remove_outliers": true,
        "outlier_threshold": 3
      },
      "note": "targets delta 6b: master propagates NA into the outlier flag, edgy masks it"
    },
    {
      "id": "bc-combat",
      "qc": {
        "batchcorrect": true,
        "bec_method": "ComBat",
        "bec_param": [
          "cluster"
        ]
      },
      "note": "batch correction runs inside createPGX, downstream of the preprocess seam"
    },
    {
      "id": "bc-limma",
      "qc": {
        "batchcorrect": true,
        "bec_method": "limma",
        "bec_param": [
          "cluster"
        ]
      }
    },
    {
      "id": "bc-npm",
      "qc": {
        "batchcorrect": true,
        "bec_method": "NPM"
      }
    },
    {
      "id": "proteomics-baseline",
      "fixture": "mini-example",
      "qc": {
        "normalization_method": "maxMedian"
      },
      "note": "different datatype branch: no CPM/TMM, proteomics norm method list"
    },
    {
      "id": "dups-baseline",
      "fixture": "human-dups",
      "note": "duplicated gene symbols, default settings - the cleanX intersect() collapse"
    },
    {
      "id": "dups-outlier",
      "fixture": "human-dups",
      "qc": {
        "remove_outliers": true,
        "outlier_threshold": 3
      },
      "note": "duplicates + outlier removal (cleanX does both)"
    },
    {
      "id": "dups-metabolomics",
      "fixture": "metabolomics-dups",
      "qc": {
        "normalization_method": "maxMedian"
      },
      "note": "duplicates on the metabolomics branch"
    }
  ]
}
