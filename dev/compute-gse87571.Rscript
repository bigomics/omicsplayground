## Compute GSE87571 (Johansson et al 2013, continuous aging of the human
## methylome, whole blood, ages 14-94) into TWO pgx:
##
##   data/GSE87571-methyl-full.pgx     all 732 individuals
##   data/GSE87571-methyl-sub150.pgx   150 individuals, stratified across age
##
## Input : data/GSE87571/GSE87571_matrix{1,2}of2.txt.gz
##         GEO supplementary matrices - 485,512 probe rows, one (Beta,
##         Detection_Pval) column pair per sample, columns named X1..X732.
##         Betas are used as shipped - no IDATs, no BMIQ.
##         data/GSE87571/GSE87571_gsm_all.txt dir + xlsx for metadata
##         (gender/age from the GSM records, year_of_collection/smoke from
##         the additional-characteristics workbook).
##
## Run:   Rscript dev/compute-gse87571.Rscript

suppressMessages({
  library(playbase)
  library(data.table)
  library(matrixStats)
})
setwd("/home/massagno/bigomics/GitHub/omicsplayground-methylome-app")
t.start <- Sys.time()
msg <- function(...) cat(format(Sys.time(), "%H:%M:%S"), "|", ..., "\n")

try(assignInNamespace(
  "annotate_phospho_residue",
  function(features, detect.only = FALSE) if (detect.only) FALSE else NULL,
  ns = "playbase"
), silent = TRUE)

DIR <- "data/GSE87571"

## ---------------------------------------------------------------- 1. metadata
msg("[1/7] parsing GSM records ...")
gsm.files <- list.files(file.path(DIR, "gsm"), full.names = TRUE, pattern = "\\.txt$")
stopifnot(length(gsm.files) == 732)

samples <- do.call(rbind, lapply(gsm.files, function(f) {
  ln <- readLines(f)
  get <- function(key) sub("^.*=\\s*", "", grep(key, ln, value = TRUE)[1])
  title <- get("!Sample_title")
  data.frame(
    array_name = sub("^X([0-9]+).*$", "X\\1", title),
    geo        = get("!Sample_geo_accession"),
    gender     = sub("^.*gender:\\s*", "", grep("gender:", ln, value = TRUE)[1]),
    age        = suppressWarnings(as.numeric(sub("^.*age:\\s*", "",
                   grep("age:", ln, value = TRUE)[1]))),
    stringsAsFactors = FALSE
  )
}))
stopifnot(!anyDuplicated(samples$array_name), !anyDuplicated(samples$geo))

char <- as.data.frame(readxl::read_excel(
  file.path(DIR, "GSE87571_additional_sample_chararcteristics.xlsx"),
  sheet = 1, skip = 2))
char <- char[, 1:3]
colnames(char) <- c("geo", "year_of_collection", "smoke")
char$year_of_collection <- suppressWarnings(as.numeric(char$year_of_collection))
char$smoke <- factor(ifelse(is.na(char$smoke), NA,
  ifelse(char$smoke == "0", "never", "ever")))
samples <- merge(samples, char, by = "geo")
stopifnot(nrow(samples) == 732)
rownames(samples) <- samples$geo   ## keyed: never subset this frame positionally
msg("      ", nrow(samples), " samples | age ",
    min(samples$age, na.rm = TRUE), "-", max(samples$age, na.rm = TRUE),
    " | gender: ", paste(names(table(samples$gender)),
    table(samples$gender), collapse = "/"))

## ---------------------------------------------------------------- 2. betas
CACHE <- file.path(DIR, "betas_gse87571.rds")
if (file.exists(CACHE)) {
  msg("[2/7] loading cached beta matrix ...")
  X <- readRDS(CACHE)
} else {
  msg("[2/7] reading beta columns (detP pairs dropped at read time) ...")
  read.betas <- function(f) {
    hdr <- strsplit(readLines(f, n = 1L), "\t")[[1]]
    ## layout: ID_REF, then (beta, detP) pairs; detP carries the ".1" suffix
    beta.idx <- which(hdr == "ID_REF" | !grepl("\\.[0-9]+$", hdr))
    dt <- fread(f, select = beta.idx, showProgress = FALSE)
    ids <- as.character(dt[[1]])
    m <- as.matrix(dt[, -1])
    storage.mode(m) <- "double"
    colnames(m) <- hdr[beta.idx][-1]
    rownames(m) <- ids
    m
  }
  b1 <- read.betas(file.path(DIR, "GSE87571_matrix1of2.txt.gz"))
  msg("      part 1: ", paste(dim(b1), collapse = " x "))
  b2 <- read.betas(file.path(DIR, "GSE87571_matrix2of2.txt.gz"))
  msg("      part 2: ", paste(dim(b2), collapse = " x "))
  stopifnot(all(rownames(b2) == rownames(b1)))
  X <- cbind(b1, b2)
  rm(b1, b2); invisible(gc())
  saveRDS(X, CACHE)
}
msg("[3/7] betas: ", paste(dim(X), collapse = " x "),
    " | NAs: ", round(mean(is.na(X)) * 100, 2), "%",
    " | range [", min(X, na.rm = TRUE), ",", max(X, na.rm = TRUE), "]")

## key everything on the GSM id - skipped when reloading a cached matrix
## that was already renamed
if (!all(grepl("^GSM", colnames(X), ignore.case = TRUE))) {
  jj <- match(sub("^X", "", colnames(X)), sub("^X", "", samples$array_name))
  if (anyNA(jj)) stop("unmapped columns: ",
    paste(colnames(X)[is.na(jj)], collapse = ","))
  colnames(X) <- samples$geo[jj]
}

## ------------------------------------------------------- 3b. probe selection
## A 485k x 150 matrix is too big to ship, and every way of thinning it that
## ranks probes by variance destroys the epigenetic clocks: Horvath needs a
## specific 353 CpGs and none of them is picked for being variable. The first
## build did exactly that and reported a Horvath age of 26 for a 46-year-old.
##
## So the set is anchored on what the panels need, then padded:
##   - every CpG the methylclock clocks use, except BLUP's 319k (the whole
##     array, not a panel - it is withheld below its coverage floor either way)
##   - the imprinted DMRs (wateRmelon::iDMR), for the imprinting panel
##   - every chrY probe plus a sample of chrX, for the sex check and the
##     X-inactivation figure. SUBSAMPLED on purpose: chrX/chrY is 11,648 of the
##     450k array and taking all of it would be 43% of a 27k set - the sex
##     chromosomes would then dominate the Manhattan, the chromosomal profile
##     and the hit proportion. infer_sex_methyl() takes a column median over
##     whatever is present, so a sample serves it; but it thresholds on chrY,
##     of which the array has only ~416 probes, so chrY is kept whole.
##   - a background of random 2kb genomic BINS, not random probes: dmrff needs
##     CpGs within a few hundred bp of one another, and a flat 3% sample of the
##     array has none, so region calling would come back empty.
##
## The background is random rather than variance-ranked on purpose. Johansson
## 2013's headline is a PROPORTION - age hits 29% of sites - and only an
## unbiased background can reproduce a proportion.
msg("[3b/7] selecting probes ...")
suppressMessages(require("IlluminaHumanMethylation450kanno.ilmn12.hg19", character.only = TRUE))
an <- minfi::getAnnotation(IlluminaHumanMethylation450kanno.ilmn12.hg19)

pe <- asNamespace("playbase.epigenetics")
clock.cg <- unique(unlist(lapply(
  setdiff(get("EPIGENETIC_CLOCKS", pe), "BLUP"),
  function(cl) names(get("clock_weights", pe)(cl)))))
clock.cg <- grep("^cg", clock.cg, value = TRUE)

idmr <- tryCatch({
  e <- new.env(); utils::data("iDMR", package = "wateRmelon", envir = e)
  get("iDMR", envir = e)
}, error = function(e) character(0))

set.seed(1234)
N.CHRX <- 2000
N.BINS <- 8800
sexchr <- c(rownames(an)[an$chr == "chrY"],
            sample(rownames(an)[an$chr == "chrX"], N.CHRX))
bin <- paste0(an$chr, ":", an$pos %/% 2000L)
auto.bins <- unique(bin[!an$chr %in% c("chrX", "chrY")])
bg <- rownames(an)[bin %in% sample(auto.bins, N.BINS)]

sel.probes <- intersect(rownames(X), unique(c(clock.cg, idmr, sexchr, bg)))
stopifnot(length(intersect(sel.probes, clock.cg)) / length(clock.cg) > 0.95)
msg("      probes ", nrow(X), " -> ", length(sel.probes),
    " | clock ", length(intersect(sel.probes, clock.cg)),
    " | iDMR ", length(intersect(sel.probes, idmr)),
    " | sexchr ", length(intersect(sel.probes, sexchr)),
    " | background ", length(intersect(sel.probes, bg)))
rm(bg, bin, auto.bins); invisible(gc())

## ---------------------------------------------------------------- 4. subsets
build.one <- function(x, smp, contrasts, name, description) {
  msg("[pgx] createPGX ", name, " ...")
  pgx <- playbase::pgx.createPGX(
    counts              = x,
    samples             = smp,
    contrasts           = contrasts,
    organism            = "Human",
    datatype            = "methylomics",
    meth_type           = "450K array",
    dma                 = "Differentially methylated positions",
    name                = name,
    creator             = "omicsplayground-methylome-app/dev",
    description         = description,
    X                   = x,
    is.logx             = FALSE,
    norm_method         = "none",
    batch.correct.method = "no_batch_correct",
    max.genesets        = 200,
    filter.genes        = FALSE,
    only.known          = FALSE,
    only.proteincoding  = FALSE
  )
  msg("[pgx] computePGX ", name, " ...")
  playbase::pgx.computePGX(
    pgx,
    ## nrow(x): the probe set is chosen below, deliberately. The default 25000
    ## re-trims it by row SD and silently drops most of the clock CpGs - which
    ## is how the first build shipped a Horvath age of 26 for a 46-year-old.
    max.genes    = nrow(x),
    gx.methods   = c("trend.limma"),
    gset.methods = c("fisher"),
    do.cluster   = TRUE
  )
}

mk.contrasts <- function(smp) {
  qs <- quantile(smp$age, c(1 / 3, 2 / 3), na.rm = TRUE)
  ## age first: Johansson 2013 regresses methylation on CONTINUOUS age adjusted
  ## for sex, and the app fits that directly from the sample sheet. These two
  ## are the two-group stand-ins every other screen needs, and the tertile
  ## split is what makes `old_vs_young` the same axis as the paper's.
  data.frame(
    old_vs_young   = ifelse(is.na(smp$age), NA,
                     ifelse(smp$age >= qs[2], "old",
                     ifelse(smp$age <= qs[1], "young", NA))),
    female_vs_male = ifelse(is.na(smp$gender), NA,
                     ifelse(smp$gender == "Female", "female", "male")),
    row.names = rownames(smp),
    stringsAsFactors = FALSE
  )
}

## ---------------------------------------------------------------- 6. sub150
## built FIRST: the small cohort is the guaranteed deliverable, and the full
## 732-sample build below is memory-hungry enough to have OOM-killed once.
set.seed(1234)
n.sub <- 150
## stratified by age tertile so the full 14-94 span survives the thinning,
## with proportional gender representation inside each stratum
stratum <- with(samples, ifelse(age <= quantile(age, 1 / 3, na.rm = TRUE), "young",
                         ifelse(age >= quantile(age, 2 / 3, na.rm = TRUE), "old", "mid")))
keep <- unlist(lapply(split(seq_len(nrow(samples)), stratum), function(ii) {
  ii.f <- split(ii, samples$gender[ii])
  k <- round(n.sub * length(ii) / nrow(samples))
  unlist(lapply(ii.f, function(g) if (length(g)) sort(sample(g, max(1, round(k * length(g) / length(ii)))))))
}))
if (length(keep) > n.sub) {
  keep <- setdiff(keep, sample(keep, length(keep) - n.sub))
}
samples.sub <- samples[keep, ]
rownames(samples.sub) <- samples.sub$geo
msg("[4/7] subsample: n=", nrow(samples.sub),
    " | age ", min(samples.sub$age, na.rm = TRUE), "-", max(samples.sub$age, na.rm = TRUE),
    " | median ", median(samples.sub$age, na.rm = TRUE), " (full: ",
    median(samples$age, na.rm = TRUE), ")")

X.sub <- X[sel.probes, samples.sub$geo]
outfile.sub <- "data/GSE87571-methyl-sub150.pgx"
pgx.sub <- build.one(
  X.sub, samples.sub, mk.contrasts(samples.sub),
  name = "GSE87571-methylation-sub150",
  description = paste0(
    "GSE87571 (Johansson, Enroth & Gyllensten 2013, PLoS ONE 8:e67378): ",
    "150 of 732 whole-blood individuals from the Northern Sweden Population ",
    "Health Study, sampled stratified across the 15-83 age range and ",
    "gender-balanced within strata. Illumina HumanMethylation450k, beta values ",
    "as shipped by GEO, no further normalisation and no batch correction - the ",
    "paper found no plate effect and left it out of the model. ",
    length(sel.probes), " probes: every methylclock CpG except BLUP's, the ",
    "imprinted DMRs, chrX/chrY, and an unbiased background of random 2kb bins. ",
    "The published model is methylation ~ age + sex + BMI; BMI is not in the ",
    "GEO metadata, so age adjusted for sex is what this dataset supports. ",
    "Headline to reproduce: age associates with ~29% of CpG sites, 60.5% of ",
    "them losing and 39.5% gaining methylation.")
)
save(pgx.sub, file = outfile.sub, compress = TRUE)
msg("SAVED ", outfile.sub, " (", round(file.info(outfile.sub)$size / 1e6), " MB)")
rm(pgx.sub, X.sub); invisible(gc())

## ---------------------------------------------------------------- 5. full pgx
## Opt-in: this build OOM-killed at ~23GB once already and nothing ships from
## it. Set GSE87571_FULL=1 to run it.
if (!nzchar(Sys.getenv("GSE87571_FULL"))) {
  msg("[5/7] full build skipped (set GSE87571_FULL=1 to run it)")
  msg("[7/7] total runtime: ",
      round(difftime(Sys.time(), t.start, units = "mins"), 1), " min")
  quit(save = "no")
}
## The full 485k x 732 beta matrix OOM-killed at ~23GB during sample
## clustering, so the probe set is trimmed to the most variable CpGs before
## createPGX. Age-associated CpGs are highly variable, so the published
## age signal is unaffected; stated in the description for honesty.
N.FULL.PROBES <- 250000
v <- matrixStats::rowVars(X[, 1:min(200, ncol(X))], na.rm = TRUE)   ## variance on a column sample
names(v) <- rownames(X)
sel <- names(head(sort(v, decreasing = TRUE), N.FULL.PROBES))
rm(v); invisible(gc())
msg("[5/7] full build: trimming probes ", nrow(X), " -> ", length(sel))
samples.full <- samples[match(colnames(X), samples$geo), ]
rownames(samples.full) <- samples.full$geo
outfile.full <- "data/GSE87571-methyl-full.pgx"
pgx.full <- build.one(
  X[sel, ], samples.full, mk.contrasts(samples.full),
  name = "GSE87571-methylation-full",
  description = paste0(
    "GSE87571 complete cohort (Johansson et al 2013): DNA methylation of ",
    "whole blood from ", ncol(X), " individuals aged 14-94, Illumina HumanMethylation450k. ",
    "Beta values as shipped by GEO, no further normalisation. ",
    "Probes trimmed to the ", length(sel), " most variable CpGs for tractability ",
    "(age CpGs are highly variable, so the published signal is retained). ",
    "Published finding reproduced in-app: age associates with ~29% of CpGs.")
)
save(pgx.full, file = outfile.full, compress = TRUE)
msg("SAVED ", outfile.full, " (", round(file.info(outfile.full)$size / 1e6), " MB)")

msg("[7/7] total runtime: ",
    round(difftime(Sys.time(), t.start, units = "mins"), 1), " min")
